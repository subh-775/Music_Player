<?xml version="1.0" encoding="utf-8"?>
<!--
  The alternate launcher mark, selectable from Settings > Appearance.

  Same shape as ic_launcher: the launcher masks the BACKGROUND to whatever it
  uses (circle, squircle, rounded square) and leaves the foreground alone, and
  the foreground sits inside the 72dp safe zone so no mask can clip it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_bl_background" />
  <foreground android:drawable="@mipmap/ic_launcher_bl_foreground" />
  <monochrome android:drawable="@mipmap/ic_launcher_bl_foreground" />
</adaptive-icon>
