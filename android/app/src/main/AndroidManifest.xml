<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- In-app update: download the release APK and launch the system installer.
         The user still confirms the install; this only lets us start it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Audio keeps playing when the app is backgrounded or the screen is off.
         That requires a foreground service (typed mediaPlayback on API 34+), a
         wake lock, and — on API 33+ — permission to post its notification, which
         is also the lock-screen transport UI. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Cleartext is NOT permitted app-wide. network_security_config scopes it
         to 127.0.0.1/localhost (the embedded Python backend) and leaves every
         real source TLS-only. The blanket usesCleartextTraffic="true" that used
         to sit here was redundant while the config was present, and would have
         silently re-opened cleartext everywhere the moment anyone removed the
         config attribute. -->
    <!--
         Package visibility (Android 11+). resolveActivity() and
         queryIntentActivities() are FILTERED unless the intents they ask about
         are declared here — they come back null for apps that can in fact
         handle them. openFolder() checks resolution before launching each
         candidate, so without this block it would skip every one of them and
         report that nothing on the device can open a folder.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW_DOWNLOADS" />
        </intent>
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="true">
      <!--
        MainActivity carries NO launcher filter of its own. Every icon is an
        activity-alias pointing here, which is what makes them symmetric: one
        of them is enabled, the rest are not, and switching is enabling the new
        one and disabling the old.

        The alternative — leaving the default filter on the activity and adding
        aliases beside it — means the default is switched off by disabling
        MainActivity itself. That disables the component the aliases TARGET, so
        every icon stops working at once and the app becomes unlaunchable with
        no way back in to fix it. This shape cannot express that state.
      -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true" />

      <!--
        The icons. `targetActivity` is the same for all of them, so whichever is
        enabled launches the identical app — the alias is a name and a picture,
        not a second entry point.

        DEFAULT is enabled at install; the rest are not. IconModule enables the
        new one BEFORE disabling the old, so there is no instant at which the
        app has no launcher entry even if the process dies between the calls.
      -->
      <activity-alias
        android:name=".Icon.Default"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>

      <activity-alias
        android:name=".Icon.Midnight"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_bl"
        android:roundIcon="@mipmap/ic_launcher_bl_round"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>

      <!-- Serves the downloaded update APK to the system installer as a
           content:// URI (a file:// URI throws FileUriExposedException on
           API 24+). -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>
    </application>
</manifest>
