# Keep line endings sane across Windows dev + Linux CI.
* text=auto

# These MUST stay LF or they break on the Linux build runner.
gradlew text eol=lf
*.sh text eol=lf

# Python is executed on-device; keep it LF regardless of the dev OS.
*.py text eol=lf

# Binary — never touch.
*.keystore binary
*.jar binary
*.png binary
*.jpg binary
*.webp binary
